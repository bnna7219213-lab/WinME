  7099                                  ; ============================================================================
  7100                                  ; eth_rx — classify received Ethernet frame by EtherType via RTL8139
  7101                                  ;   Properly polls RX ring: checks ISR for ROK, reads per-packet header
  7102                                  ;   (status+size DWORD), copies data to nic_rx_data, advances CAPR.
  7103                                  ;   RX ring size = 8192 bytes (RCR RBLEN=00).
  7104                                  ; ============================================================================
  7105                                  eth_rx:
  7106 00005232 57                          push    edi
  7107 00005233 52                          push    edx
  7108 00005234 51                          push    ecx
  7109 00005235 53                          push    ebx
  7110 00005236 50                          push    eax
  7111 00005237 803D[52B40000]01            cmp     byte [nic_type], 1
  7112 0000523E 0F8503050000                jne     .er_d
  7113                                  .er_next_pkt:
  7114                                      ; ----- Check if any packet is available -----
  7115                                      ; Method 1: ISR.ROK at 0x3E bit 0 (primary, works with RTL8139 IRQ status)
  7116 00005244 B03E                        mov     al, 0x3E
  7117 00005246 E81ADBFFFF                  call    rtl8139_rd_w         ; ax = ISR
  7118 0000524B 6689C3                      mov     bx, ax
  7119 0000524E F6C301                      test    bl, 0x01             ; ROK (Receive OK) interrupt bit
  7120 00005251 0F85F1010000                jnz     .er_process
  7121                                      ; Method 2: Pure ring-head poll. RTL8139 does NOT expose a "CBR" register
  7122                                      ; at 0x3A (that is TSD0 upper = TX status 0).  Instead we peek the next
  7123                                      ; expected packet-header DWORD in the RX ring at offset (CAPR+0x10) mod 8K.
  7124                                      ; If its ROK bit (dword bit 0) is set, NIC has finished writing this packet.
  7125 00005257 B038                        mov     al, 0x38
  7126 00005259 E807DBFFFF                  call    rtl8139_rd_w         ; ax = CAPR
  7127 0000525E 0FB7C8                      movzx   ecx, ax
  7128 00005261 6683C110                    add     cx, 0x10
  7129 00005265 6681E1FF1F                  and     cx, 0x1FFF           ; ecx = next expected header offset
  7130 0000526A BE[00CC0000]                mov     esi, rtl8139_rx_buf
  7131 0000526F 01CE                        add     esi, ecx             ; esi = &rx_buf[next_header_off]
  7132 00005271 8B06                        mov     eax, [esi]           ; eax = 32-bit packet header (status + size)
  7133 00005273 66A93F00                    test    ax, 0x003F           ; Check ROK(bit0) + error bits(0x3E) in low 16 bits
  7134 00005277 0F85CB010000                jnz     .er_process         ; ROK or errors set → packet present (even if bad)
  7135 0000527D 668B06                      mov     ax, [esi]            ; re-read low 16 bits
  7136 00005280 A90000FFFF                  test    eax, 0xFFFF0000      ; Check if upper 16 bits (frame size) are non-zero
  7137 00005285 0F85BD010000                jnz     .er_process         ; Size > 0 → packet present
  7138                                      ; One-shot debug: print why no packet was found (ISR, CAPR, peek value)
  7139 0000528B 803D[FFC10000]01            cmp     byte [eth_rx_dbg_logged], 1
  7140 00005292 0F84AF040000                je      .er_d
  7141 00005298 C605[FFC10000]01            mov     byte [eth_rx_dbg_logged], 1
  7142 0000529F 50                          push    eax
  7143 000052A0 53                          push    ebx
  7144 000052A1 51                          push    ecx
  7145 000052A2 52                          push    edx
  7146                                      dbg_puts "[A4X] eth_rx NOPKT ISR=", 0
