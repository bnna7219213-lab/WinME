     1                                  ; ============================================================================
     2                                  ; a4x_gui.asm - M-A4+ Win9x enhanced GUI (boot32+VIDEO_MODE=0x13 pipeline)
     3                                  ;   Uses the SAME boot32 pipeline verified by M-D2:
     4                                  ;     boot32.asm loads kernel at 0x8000, relocates to 0x100000, jumps.
     5                                  ;     Kernel: BITS 32, ORG 0x100000, flat addressing, base 0 for data.
     6                                  ;
     7                                  ;   Features:
     8                                  ;     - LFB double buffer (0x30000 -> 0xA0000)
     9                                  ;     - 64-color palette, blue gradient desktop
    10                                  ;     - Window manager: Z-order, drag, min/max/restore/close
    11                                  ;     - Mouse driver (PS/2 IRQ12) + arrow cursor + hit test
    12                                  ;     - Start menu + right-click context menu + taskbar
    13                                  ;     - VIN virtual input script (deterministic demo)
    14                                  ;     - VMM/VTD (PIT IRQ0) message loop
    15                                  ; ============================================================================
    16                                  BITS 32
    17                                  ORG 0x100000
    18                                  %include "common/debug.inc"
     1                              <1> ; ============================================================================
     2                              <1> ; debug.inc — QEMU 0xE9 debug port output macros (shared by all axes)
     3                              <1> ; ----------------------------------------------------------------------------
     4                              <1> ;  Usage:  %include "common/debug.inc"
     5                              <1> ;          dbg_puts "hello", 13, 10, 0
     6                              <1> ;
     7                              <1> ;  Works in both 16-bit and 32-bit code (uses out instruction, no BIOS).
     8                              <1> ;  The QEMU flag -debugcon file:dbg.log captures all 0xE9 output.
     9                              <1> ; ============================================================================
    10                              <1> 
    11                              <1> ; --- dbg_putc : write AL to port 0xE9 (16-bit) ------------------------------
    12                              <1> %macro dbg_putc 0
    13                              <1>     out     0xE9, al
    14                              <1> %endmacro
    15                              <1> 
    16                              <1> ; --- dbg_puts : emit a NUL-terminated string literal to 0xE9 ----------------
    17                              <1> ;  Accepts 1 or more arguments (all collected into %1 as a single token list).
    18                              <1> ;  Usage:  dbg_puts "hello", 13, 10, 0
    19                              <1> ;  Works in BITS 16 and BITS 32 (detected via __BITS__).
    20                              <1> %macro dbg_puts 1+
    21                              <1>     jmp     %%skip
    22                              <1> %%str   db  %1
    23                              <1> %%skip:
    24                              <1> %if __BITS__ == 32
    25                              <1>     push    esi
    26                              <1>     mov     esi, %%str
    27                              <1> %%.loop:
    28                              <1>     lodsb
    29                              <1>     or      al, al
    30                              <1>     jz      %%.done
    31                              <1>     out     0xE9, al
    32                              <1>     jmp     %%.loop
    33                              <1> %%.done:
    34                              <1>     pop     esi
    35                              <1> %else
    36                              <1>     push    si
    37                              <1>     mov     si, %%str
    38                              <1> %%.loop:
    39                              <1>     lodsb
    40                              <1>     or      al, al
    41                              <1>     jz      %%.done
    42                              <1>     out     0xE9, al
    43                              <1>     jmp     %%.loop
    44                              <1> %%.done:
    45                              <1>     pop     si
    46                              <1> %endif
    47                              <1> %endmacro
    48                              <1> 
    49                              <1> ; --- dbg_nl : emit CR+LF to 0xE9 --------------------------------------------
    50                              <1> %macro dbg_nl 0
    51                              <1>     mov     al, 13
    52                              <1>     out     0xE9, al
    53                              <1>     mov     al, 10
    54                              <1>     out     0xE9, al
    55                              <1> %endmacro
    56                              <1> 
    57                              <1> ; --- dbg_hex8 : print AL as 2 hex digits to 0xE9 ---------------------------
    58                              <1> %macro dbg_hex8 0
    59                              <1>     push    ax
    60                              <1>     mov     ah, al
    61                              <1>     shr     al, 4
    62                              <1>     call    %%hex_nibble
    63                              <1>     mov     al, ah
    64                              <1>     and     al, 0x0F
    65                              <1>     call    %%hex_nibble
    66                              <1>     pop     ax
    67                              <1>     jmp     %%done
    68                              <1> %%hex_nibble:
    69                              <1>     add     al, '0'
    70                              <1>     cmp     al, '9'
    71                              <1>     jbe     %%ok
    72                              <1>     add     al, 7        ; 'A' - '0' - 10 = 7
    73                              <1> %%ok:
    74                              <1>     out     0xE9, al
    75                              <1>     ret
    76                              <1> %%done:
    77                              <1> %endmacro
    78                              <1> 
    79                              <1> ; --- dbg_hex32 : print EAX as 8 hex digits to 0xE9 (32-bit only) -----------
    80                              <1> ;  The previous implementation only emitted 4 digits: its helper printed the
    81                              <1> ;  two nibbles of AL and was called twice on a rotated EAX, so bytes 1 and 3
    82                              <1> ;  were silently dropped.  Shift out all 8 nibbles instead.
    83                              <1> %macro dbg_hex32 0
    84                              <1>     push    eax
    85                              <1>     push    ecx
    86                              <1>     mov     ecx, 28
    87                              <1> %%loop:
    88                              <1>     push    eax
    89                              <1>     shr     eax, cl
    90                              <1>     and     eax, 0x0F
    91                              <1>     add     al, '0'
    92                              <1>     cmp     al, '9'
    93                              <1>     jbe     %%ok2
    94                              <1>     add     al, 7            ; 'A' - '0' - 10 = 7
    95                              <1> %%ok2:
    96                              <1>     out     0xE9, al
    97                              <1>     pop     eax
    98                              <1>     sub     ecx, 4
    99                              <1>     jns     %%loop
   100                              <1>     pop     ecx
   101                              <1>     pop     eax
   102                              <1> %endmacro
    19                                  %include "common/gdt.inc"
     1                              <1> ; ============================================================================
     2                              <1> ; gdt.inc — GDT (Global Descriptor Table) macros for 32-bit protected mode
     3                              <1> ; ----------------------------------------------------------------------------
     4                              <1> ;  Usage:  %include "common/gdt.inc"
     5                              <1> ;
     6                              <1> ;  Provides:
     7                              <1> ;    gdt_entry  base, limit, flags, access  — build one 8-byte descriptor
     8                              <1> ;    gdt_load   label                       — lgdt from a gdt_descriptor
     9                              <1> ;
    10                              <1> ;  Standard descriptor sets are provided as macros:
    11                              <1> ;    GDT_FLAT    — null + flat code + flat data (4GB each)
    12                              <1> ;    GDT_RING3   — flat + ring3 code + ring3 data (adds two entries)
    13                              <1> ; ============================================================================
    14                              <1> 
    15                              <1> ; --- Descriptor field layout (x86 GDT entry, 8 bytes) ---
    16                              <1> ;   bits  0-15  : limit  low
    17                              <1> ;   bits 16-39  : base   low/mid
    18                              <1> ;   bits 40-47  : access byte
    19                              <1> ;   bits 48-51  : limit  high (bits 16-19)
    20                              <1> ;   bits 52-55  : flags   (Granularity, Size, L, Reserved)
    21                              <1> ;   bits 56-63  : base   high
    22                              <1> 
    23                              <1> struc gdt_entry_t
    24 00000000 ????                <1>     .limit_lo   resw 1
    25 00000002 ????                <1>     .base_lo    resw 1
    26 00000004 ??                  <1>     .base_mid   resb 1
    27 00000005 ??                  <1>     .access     resb 1
    28 00000006 ??                  <1>     .flags_lim  resb 1
    29 00000007 ??                  <1>     .base_hi    resb 1
    30                              <1> endstruc
    31                              <1> 
    32                              <1> ; Access byte bits:
    33                              <1> ;   7 Present | 6-5 DPL | 4 S(1=code/data) | 3 E/DT | 2 DC | 1 R/W | 0 A
    34                              <1> ACCESS_RING0_CODE  equ 0x9A   ; Present, ring0, code, executable, read
    35                              <1> ACCESS_RING0_DATA  equ 0x92   ; Present, ring0, data, writable
    36                              <1> ACCESS_RING3_CODE  equ 0xFA   ; Present, ring3, code, executable, read
    37                              <1> ACCESS_RING3_DATA  equ 0xF2   ; Present, ring3, data, writable
    38                              <1> 
    39                              <1> ; Flags nibble (bits 52-55):
    40                              <1> ;   7 Granularity (1=4K) | 6 D/B (1=32-bit) | 5 L (64-bit, keep 0) | 4 Reserved
    41                              <1> FLAG_4K_32BIT      equ 0xCF   ; G=1, D=1, L=0, 0
    42                              <1> 
    43                              <1> ; --- gdt_entry : emit one 8-byte descriptor --------------------------------
    44                              <1> ;  %1=base(32)  %2=limit(20)  %3=access  %4=flags
    45                              <1> %macro gdt_entry 4
    46                              <1>     dw      (%2) & 0xFFFF                       ; limit 0-15
    47                              <1>     dw      (%1) & 0xFFFF                       ; base  0-15
    48                              <1>     db      ((%1) >> 16) & 0xFF                  ; base 16-23
    49                              <1>     db      (%3) & 0xFF                          ; access
    50                              <1>     db      (((%2) >> 16) & 0x0F) | ((%4) & 0xF0) ; flags + limit 16-19
    51                              <1>     db      ((%1) >> 24) & 0xFF                  ; base 24-31
    52                              <1> %endmacro
    53                              <1> 
    54                              <1> ; --- GDT descriptor (pseudo-descriptor for lgdt) ----------------------------
    55                              <1> struc gdt_desc_t
    56 00000000 ????                <1>     .limit   resw 1
    57 00000002 ????????            <1>     .base    resd 1
    58                              <1> endstruc
    59                              <1> 
    60                              <1> ; --- gdt_load : lgdt from a named descriptor -------------------------------
    61                              <1> %macro gdt_load 1
    62                              <1>     lgdt    [%1]
    63                              <1> %endmacro
    64                              <1> 
    65                              <1> ; ============================================================================
    66                              <1> ; Standard GDT sets
    67                              <1> ; ============================================================================
    68                              <1> 
    69                              <1> ; --- GDT_FLAT : null + ring0 code (4GB) + ring0 data (4GB) ------------------
    70                              <1> ;  Use after entering 32-bit mode. Selector 0x08 = code, 0x10 = data.
    71                              <1> %macro GDT_FLAT 0
    72                              <1> ALIGN 8
    73                              <1> gdt_data:
    74                              <1>     gdt_entry 0, 0, 0, 0                       ; null descriptor (selector 0x00)
    75                              <1>     gdt_entry 0, 0xFFFFF, ACCESS_RING0_CODE, FLAG_4K_32BIT  ; code  (selector 0x08)
    76                              <1>     gdt_entry 0, 0xFFFFF, ACCESS_RING0_DATA, FLAG_4K_32BIT  ; data  (selector 0x10)
    77                              <1> gdt_descriptor:
    78                              <1>     dw      gdt_data_end - gdt_data - 1
    79                              <1>     dd      gdt_data
    80                              <1> gdt_data_end:
    81                              <1> %endmacro
    82                              <1> 
    83                              <1> ; --- GDT_RING3 : GDT_FLAT + ring3 code + ring3 data + TSS -------------------
    84                              <1> ;  Selector 0x08 = ring0 code, 0x10 = ring0 data,
    85                              <1> ;  0x18 = ring3 code, 0x20 = ring3 data, 0x28 = TSS
    86                              <1> %macro GDT_RING3 0
    87                              <1> ALIGN 8
    88                              <1> gdt_data:
    89                              <1>     gdt_entry 0, 0, 0, 0                       ; null     (0x00)
    90                              <1>     gdt_entry 0, 0xFFFFF, ACCESS_RING0_CODE, FLAG_4K_32BIT  ; ring0 code (0x08)
    91                              <1>     gdt_entry 0, 0xFFFFF, ACCESS_RING0_DATA, FLAG_4K_32BIT  ; ring0 data (0x10)
    92                              <1>     gdt_entry 0, 0xFFFFF, ACCESS_RING3_CODE, FLAG_4K_32BIT  ; ring3 code (0x18)
    93                              <1>     gdt_entry 0, 0xFFFFF, ACCESS_RING3_DATA, FLAG_4K_32BIT  ; ring3 data (0x20)
    94                              <1>     ; TSS descriptor (placeholder, 104 bytes minimum)
    95                              <1>     gdt_entry 0, 0x67, 0x89, 0x40               ; TSS      (0x28) — present, ring0, 32-bit
    96                              <1> gdt_descriptor:
    97                              <1>     dw      gdt_data_end - gdt_data - 1
    98                              <1>     dd      gdt_data
    99                              <1> gdt_data_end:
   100                              <1> %endmacro
   101                              <1> 
   102                              <1> ; --- Selector constants (for convenience) -----------------------------------
   103                              <1> SEL_CODE0    equ 0x08
   104                              <1> SEL_DATA0    equ 0x10
   105                              <1> SEL_CODE3    equ 0x18
   106                              <1> SEL_DATA3    equ 0x20
   107                              <1> SEL_TSS      equ 0x28
    20                                  
    21                                  ; -------- constants --------
    22                                  SW          equ 320
    23                                  SH          equ 200
    24                                  VGA_FB      equ 0xA0000
    25                                  LFB         equ 0x30000           ; off-screen double buffer
    26                                  SEL_C0      equ 0x08
    27                                  SEL_D0      equ 0x10
    28                                  SEL_VGA     equ 0x18
    29                                  
    30                                  ; -------- palette indices --------
    31                                  PB  equ 0        ; black
    32                                  PW  equ 1        ; white
    33                                  PG  equ 2        ; gray (taskbar)
    34                                  PN0 equ 3        ; navy top
    35                                  PN1 equ 4        ; navy bottom
    36                                  PC  equ 5        ; client
    37                                  PD  equ 6        ; dark bevel
    38                                  PL  equ 7        ; light bevel
    39                                  PR  equ 8        ; red close
    40                                  PGN equ 9        ; green max
    41                                  PY  equ 10       ; yellow min
    42                                  MNU equ 11       ; menu bg
    43                                  MCU equ 32       ; menu cursor
    44                                  
    45                                  ; -------- window layout --------
    46                                  WAX  equ 40
    47                                  WAY  equ 10
    48                                  WAW  equ 240
    49                                  WAH  equ 130
    50                                  TH  equ 18        ; title bar height
    51                                  BS  equ 14        ; button size
    52                                  CLX  equ WAX+WAW-BS-2 ; close button x
    53                                  CLY  equ WAY+2
    54                                  MXX  equ CLX-BS-2
    55                                  MXY  equ WAY+2
    56                                  MN2X equ MXX-BS-2
    57                                  MN2Y equ WAY+2
    58                                  TBRY equ 180       ; taskbar y
    59                                  TH2 equ 20
