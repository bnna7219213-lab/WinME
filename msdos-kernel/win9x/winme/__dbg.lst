   493 00000346 50                          push    eax
   494                                      ; Clear LFB (0x30000). ES=0x10 is the flat 4GB data segment — LFB and
   495                                      ; VGA both fit inside it, so we avoid push/pop ES which breaks
   496                                      ; ESP alignment when mixed with 32-bit push/pop sequences.
