  6725                                  ; ============================================================================
  6726                                  ; net_test_inject — NET_TEST only: inject canned HTTP response into dl_code
  6727                                  ;   Bypasses ARP/DNS/TCP/HTTP. Simulates a real download by copying the
  6728                                  ;   test bytecode (0xA4 magic + program) into dl_code and setting dl_valid.
  6729                                  ; ============================================================================
  6730                                  %ifdef NET_TEST
  6731                                  net_test_inject:
  6732                                      push    esi
  6733                                      push    edi
  6734                                      push    ecx
  6735                                      push    eax
  6736                                      ; Simulate http_parse: set http_body to point past headers
  6737                                      mov     dword [http_body], test_bc_body
  6738                                      mov     eax, test_bc_body_len
  6739                                      mov     [http_body_len], ax
  6740                                      ; Phase B copy: body[0] must be BC_MAGIC, copy body[1..] to dl_code
  6741                                      mov     byte [dl_valid], 0
  6742                                      mov     esi, test_bc_body
  6743                                      mov     al, [esi]
  6744                                      cmp     al, BC_MAGIC
  6745                                      jne     .nti_d
  6746                                      inc     esi                        ; skip magic
  6747                                      mov     ecx, test_bc_body_len - 1  ; payload without magic
  6748                                      cmp     ecx, DL_CODE_SZ
  6749                                      jle     .nti_cap
  6750                                      mov     ecx, DL_CODE_SZ
  6751                                  .nti_cap:
  6752                                      mov     edi, dl_code
  6753                                      push    ecx
  6754                                      rep     movsb
  6755                                      pop     ecx
  6756                                      ; Zero-fill remainder
  6757                                      mov     eax, DL_CODE_SZ
  6758                                      sub     eax, ecx
  6759                                      mov     ecx, eax
  6760                                      xor     al, al
  6761                                      rep     stosb
  6762                                      mov     byte [dl_valid], 1
  6763                                      dbg_puts "[A4X] NET_TEST: injected downloaded bytecode (dl_valid=1)", 13, 10, 0
  6764                                  .nti_d:
  6765                                      pop     eax
  6766                                      pop     ecx
  6767                                      pop     edi
  6768                                      pop     esi
  6769                                      ret
  6770                                  %endif
