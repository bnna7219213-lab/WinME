    99                                  ; Network window
   100                                  WNET      equ 13
   101                                  ; Browser (Internet Explorer)
   102                                  WBR       equ 14
   103                                  ; Installer
   104                                  WIN       equ 15
   105                                  ; EXE Runner / Report
   106                                  WEX       equ 16
   107                                  MAXW      equ 17
   108                                  MAXM      equ 16
   109                                  WSZ       equ 32
   110                                  MSZ       equ 12
   111                                  ; Browser address bar
   112                                  BR_ADDR   equ 32
   113                                  
   114                                  ; -------- File system --------
   115                                  ; File entry layout (32 bytes each):
   116                                  ;   0-15:  name[16]
   117                                  ;   16:    type
   118                                  ;   17-20: size (legacy, kept for compatibility)
   119                                  ;   21:    flags (FS_FLG_*)
   120                                  ;   22:    parent
   121                                  ;   23:    reserved (future flags)
   122                                  ;   24-27: content_ptr  (dword: bytecode/data offset inside file_contents_pool)
   123                                  ;                         = 0xFFFFFFFF means use legacy default code path
   124                                  ;   28-31: content_len  (dword: length in bytes of the content)
   125                                  FS_NAME         equ 16
   126                                  FS_SZ           equ 32
   127                                  FS_MAXF         equ 16       ; max file entries = 2KB data
   128                                  FS_TYPE_FILE    equ 0
   129                                  FS_TYPE_FOLDER  equ 1
   130                                  FS_TYPE_COMPUTER equ 2
   131                                  FS_TYPE_TRASH   equ 3
   132                                  FS_TYPE_NETWORK equ 4
   133                                  FS_TYPE_FILE_TXT equ 5
   134                                  FS_TYPE_FILE_EXE equ 6
   135                                  FS_FLG_DELETED  equ 0x01
   136                                  FS_FLG_SYSTEM   equ 0x02
   137                                  ; --- Per-file content pointers ---
   138                                  FS_CONTENT_OFF  equ 24       ; dword
   139                                  FS_CONTENT_LEN  equ 28       ; dword
   140                                  FS_CONTENT_UNSET equ 0xFFFFFFFF
   141                                  ; --- EXE bytecode limits ---
   142                                  EXE_CONTENT_CHUNK equ 1024   ; 1KB per EXE.  16 entries * 1KB = 16KB pool
   143                                  FS_MAX_CONTENTS  equ 16
   144                                  ; --- PE loader constants ---
   145                                  PE_LOAD_BASE      equ 0x400000     ; 标准 Windows PE ImageBase，当前 2.9MB 空闲
   146                                  PE_MAX_SIZE       equ 0x10000      ; 64KB PE 镜像上限
   147                                  PE_DOWNLOAD_MAX   equ 0x10000      ; 下载缓冲上限
   148                                  
   149                                  ; -------- Net --------
   150                                  NET_NAME  equ 16
   151                                  NET_IP    equ 4
   152                                  NET_SZ    equ 32
   153                                  NET_MAXH  equ 8         ; max hosts = 256 bytes data
   154                                  
   155                                  ; -------- messages --------
   156                                  WM_PAINT  equ 1
   157                                  WM_LDOWN  equ 2
   158                                  WM_LUP    equ 3
   159                                  WM_RDOWN  equ 4
   160                                  WM_CMD    equ 5
   161                                  WM_MMV    equ 6
   162                                  WM_KEY    equ 7
   163                                  
   164                                  ; -------- button IDs --------
   165                                  B_ST equ 1
   166                                  B_MN equ 2
   167                                  B_MX equ 3
   168                                  B_CL equ 4
   169                                  
   170                                  ; -------- window states --------
   171                                  WS_HID  equ 0
   172                                  WS_NORM equ 1
   173                                  WS_MIN  equ 2
   174                                  WS_MAX  equ 3
   175                                  
   176                                  ; -------- Phase B additions --------
   177                                  DBLCLK_TICKS equ 10          ; max ticks between two title clicks for dbl-click
   178                                  BC_MAGIC     equ 0xA4        ; downloaded bytecode magic header byte
   179                                  DL_CODE_SZ   equ EXE_CONTENT_CHUNK  ; downloaded bytecode buffer = 1KB chunk
   180                                  ; dl_valid state:
   181                                  ;   0 = no download
   182                                  ;   1 = dl_code holds raw downloaded bytecode (transient, only until install)
   183                                  ;   2 = dl_code was INSTALLED into file_table and can be double-clicked as exe
   184                                  
   185                                  ; -------- VIN event types --------
   186                                  VIN_MM equ 0
   187                                  VIN_LD equ 1
   188                                  VIN_LU equ 2
   189                                  VIN_RD equ 3
   190                                  VIN_RU equ 4
   191                                  VIN_WT equ 5
   192                                  VIN_EN equ 6
   193                                  VINSZ equ 12
