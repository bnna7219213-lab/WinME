   502 00000355 BF00000A00                  mov     edi, VGA_FB
   503 0000035A F3AB                        rep     stosd
   504 0000035C 58                          pop     eax
   505 0000035D 59                          pop     ecx
   506 0000035E 5F                          pop     edi
   507 0000035F C3                          ret
