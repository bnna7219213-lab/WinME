   198                                  global_start:
   199 00000000 FA                          cli
   200 00000001 FC                          cld
   201 00000002 B041                        mov     al, 'A'
   202 00000004 E6E9                        out     0xE9, al
   203                                      ; boot32 GDT already valid (code=0x08, data=0x10, both flat 4GB, base=0).
   204                                      ; Skip redundant lgdt: the kernel GDT's extra VGA entry (0x18) is unused,
   205                                      ; and lgdt here triggers QEMU SMM entry/exit that clobbers GDTR before the
   206                                      ; far jump completes, causing #GP. Use a direct far jump to flush CS.
   207 00000006 EA[0D000000]0800            jmp     SEL_C0:.flush_cs
   208                                  .flush_cs:
   209 0000000D B042                        mov     al, 'B'
   210 0000000F E6E9                        out     0xE9, al
   211 00000011 66B81000                    mov     ax, SEL_D0
   212 00000015 8ED8                        mov     ds, ax
   213 00000017 8EC0                        mov     es, ax
   214 00000019 8EE0                        mov     fs, ax
   215 0000001B 8EE8                        mov     gs, ax
   216 0000001D 8ED0                        mov     ss, ax
   217 0000001F B043                        mov     al, 'C'
   218 00000021 E6E9                        out     0xE9, al
   219 00000023 E8C6000000                  call    build_idt
   220 00000028 B036                        mov     al, '6'
   221 0000002A E6E9                        out     0xE9, al
   222 0000002C 0F011D[900E0200]            lidt    [idt_desc_local]
   223 00000033 E8E8020000                  call    pal_init
   224 00000038 B037                        mov     al, '7'
   225 0000003A E6E9                        out     0xE9, al
   226 0000003C E803030000                  call    gdi_init
   227 00000041 B038                        mov     al, '8'
   228 00000043 E6E9                        out     0xE9, al
   229 00000045 E83F050000                  call    usr_init
   230 0000004A B039                        mov     al, '9'
   231 0000004C E6E9                        out     0xE9, al
   232 0000004E E850180000                  call    mou_init
   233 00000053 B03A                        mov     al, ':'
   234 00000055 E6E9                        out     0xE9, al
   235 00000057 E891190000                  call    kbd_init
