  3416                                      ; We'll re-scan dl_code to find actual length: first 0x00 (HALT) end marker,
  3417                                      ; but a PRINT string can contain 0 bytes that are legitimate.  Instead,
  3418                                      ; use net_download's ecx push: the copy-length was pushed as last push
  3419                                      ; before call.  However easier: re-copy DL_CODE_SZ safely and store len as
  3420                                      ; position of last non-zero byte + 1 (or DL_CODE_SZ if all non-zero).
  3421 00002417 31DB                        xor     ebx, ebx                 ; ebx = actual length
