    61                                  SYT equ 182
    62                                  SXX equ 80
    63                                  SYX equ 16
    64                                  MNX equ 4
    65                                  MNW equ 96
    66                                  MNH equ 140
    67                                  MNY equ TBRY-MNH     ; =96
    68                                  MIH equ 18
