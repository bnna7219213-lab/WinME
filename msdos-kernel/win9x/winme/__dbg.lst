    74                                  TBX       equ 88
    75                                  TBW       equ 40
    76                                  TBH       equ 16
    77                                  ICONX1    equ 12
    78                                  ICONY1    equ 10
    79                                  ICONX2    equ 12
    80                                  ICONY2    equ 74
    81                                  ICO_W     equ 16
    82                                  ICO_H     equ 16
    83                                  
    84                                  ; -------- window IDs --------
    85                                  WT        equ 0
    86                                  WB        equ 1
    87                                  WA        equ 2
    88                                  WM        equ 3
    89                                  WBN       equ 4
    90                                  WBM       equ 5
    91                                  WBC       equ 6
    92                                  WCT       equ 7
    93                                  WD        equ 8
    94                                  WN        equ 9
    95                                  WA2       equ 10
    96                                  WSH       equ 11
    97                                  ; Desktop file/browser window
