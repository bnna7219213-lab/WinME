  3429                                      ; but make at least the chunk contiguous. We cap at first 0x00 HALT op + 1 byte
  3430                                      ; so the VM stops there.
  3431 00002428 85DB                        test    ebx, ebx
  3432 0000242A 7409                        jz      .fi_found_nonzero        ; zero at offset 0? keep going
