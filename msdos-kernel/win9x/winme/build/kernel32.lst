  8883 00006F2E BB[52700000]                mov     ebx, pe_stub_table
  8884 00006F33 31C0                        xor     eax, eax
  8885                                  
  8886                                  .pdc_loop:
  8887 00006F35 8B4B10                      mov     ecx, [ebx + 16]
  8888 00006F38 85C9                        test    ecx, ecx
  8889 00006F3A 741D                        jz      .pdc_done
