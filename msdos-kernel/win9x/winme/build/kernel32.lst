  8871                                  ; ============================================================================
  8872                                  ; pe_dispatch_call: lookup function name in pe_stub_table
  8873                                  ; IN:  esi = function name string pointer
  8874                                  ; OUT: eax = stub address, 0 if not found
  8875                                  ; Clobbers: eax ebx ecx esi edi
  8876                                  ; ============================================================================
