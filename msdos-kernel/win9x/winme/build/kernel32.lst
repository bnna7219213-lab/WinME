  8961 00006F9B 7503                        jnz     .rim_has_orig
  8962 00006F9D 8B5E10                      mov     ebx, [esi + 16]
  8963                                  .rim_has_orig:
  8964                                  
  8965                                      ; thunk source RVA -> file offset (RVA passed in EAX)
  8966 00006FA0 89D8                        mov     eax, ebx
  8967 00006FA2 E8F7C7FFFF                  call    pe_rva_to_fileoff
  8968 00006FA7 83F8FF                      cmp     eax, 0xFFFFFFFF
  8969 00006FAA 7450                        je      .rim_fail_pop
  8970 00006FAC BB[1C050100]                mov     ebx, pe_download_buf     ; buffer base (label, NOT [ptr])
  8971 00006FB1 01C3                        add     ebx, eax                ; EBX -> thunks in file
  8972                                  
  8973                                  .rim_thunk_loop:
  8974 00006FB3 8B03                        mov     eax, [ebx]
  8975 00006FB5 85C0                        test    eax, eax
