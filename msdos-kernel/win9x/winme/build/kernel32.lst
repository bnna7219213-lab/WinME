  8906 00006F4E 8B4310                      mov     eax, [ebx + 16]
  8907 00006F51 EB06                        jmp     .pdc_done
  8908                                  .pdc_mismatch:
  8909 00006F53 5E                          pop     esi
  8910 00006F54 83C314                      add     ebx, 20
