  8991                                  
  8992                                      ; lookup stub function
  8993 00006FD6 57                          push    edi
  8994 00006FD7 E84EFFFFFF                  call    pe_dispatch_call        ; IN: esi=name, OUT: eax=handler
  8995 00006FDC 5F                          pop     edi
