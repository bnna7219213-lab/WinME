  6726                                  ; ============================================================================
  6727                                  ; net_test_inject — NET_TEST only: inject canned HTTP response into dl_code
  6728                                  ;   Bypasses ARP/DNS/TCP/HTTP. Simulates a real download by copying the
  6729                                  ;   test bytecode (0xA4 magic + program) into dl_code and setting dl_valid.
  6730                                  ; ============================================================================
  6731                                  %ifdef NET_TEST
  6732                                  net_test_inject:
  6733                                      push    esi
  6734                                      push    edi
  6735                                      push    ecx
