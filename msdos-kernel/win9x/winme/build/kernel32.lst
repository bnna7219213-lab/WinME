  6997                                  ; ============================================================================
  6998                                  ; eth_rx — classify received Ethernet frame by EtherType via RTL8139
  6999                                  ;   Properly polls RX ring: checks ISR for ROK, reads per-packet header
  7000                                  ;   (status+size DWORD), copies data to nic_rx_data, advances CAPR.
  7001                                  ;   RX ring size = 8192 bytes (RCR RBLEN=00).
  7002                                  ; ============================================================================
  7003                                  eth_rx:
  7004 00004FBA 57                          push    edi
  7005 00004FBB 52                          push    edx
  7006 00004FBC 51                          push    ecx
  7007 00004FBD 53                          push    ebx
  7008 00004FBE 50                          push    eax
  7009 00004FBF 803D[DAB10000]01            cmp     byte [nic_type], 1
  7010 00004FC6 0F8503050000                jne     .er_d
  7011                                  .er_next_pkt:
  7012                                      ; ----- Check if any packet is available -----
  7013                                      ; Method 1: ISR.ROK at 0x3E bit 0 (primary, works with RTL8139 IRQ status)
  7014 00004FCC B03E                        mov     al, 0x3E
  7015 00004FCE E81EDEFFFF                  call    rtl8139_rd_w         ; ax = ISR
  7016 00004FD3 6689C3                      mov     bx, ax
  7017 00004FD6 F6C301                      test    bl, 0x01             ; ROK (Receive OK) interrupt bit
  7018 00004FD9 0F85F1010000                jnz     .er_process
  7019                                      ; Method 2: Pure ring-head poll. RTL8139 does NOT expose a "CBR" register
  7020                                      ; at 0x3A (that is TSD0 upper = TX status 0).  Instead we peek the next
  7021                                      ; expected packet-header DWORD in the RX ring at offset (CAPR+0x10) mod 8K.
  7022                                      ; If its ROK bit (dword bit 0) is set, NIC has finished writing this packet.
  7023 00004FDF B038                        mov     al, 0x38
  7024 00004FE1 E80BDEFFFF                  call    rtl8139_rd_w         ; ax = CAPR
  7025 00004FE6 0FB7C8                      movzx   ecx, ax
  7026 00004FE9 6683C110                    add     cx, 0x10
  7027 00004FED 6681E1FF1F                  and     cx, 0x1FFF           ; ecx = next expected header offset
  7028 00004FF2 BE[00C90000]                mov     esi, rtl8139_rx_buf
