  6744                                      mov     al, [esi]
  6745                                      cmp     al, BC_MAGIC
  6746                                      jne     .nti_d
  6747                                      inc     esi                        ; skip magic
  6748                                      mov     ecx, test_bc_body_len - 1  ; payload without magic
  6749                                      cmp     ecx, DL_CODE_SZ
  6750                                      jle     .nti_cap
  6751                                      mov     ecx, DL_CODE_SZ
  6752                                  .nti_cap:
  6753                                      mov     edi, dl_code
  6754                                      push    ecx
  6755                                      rep     movsb
  6756                                      pop     ecx
  6757                                      ; Zero-fill remainder
  6758                                      mov     eax, DL_CODE_SZ
  6759                                      sub     eax, ecx
  6760                                      mov     ecx, eax
  6761                                      xor     al, al
  6762                                      rep     stosb
  6763                                      mov     byte [dl_valid], 1
  6764                                      dbg_puts "[A4X] NET_TEST: injected downloaded bytecode (dl_valid=1)", 13, 10, 0
  6765                                  .nti_d:
  6766                                      pop     eax
  6767                                      pop     ecx
  6768                                      pop     edi
  6769                                      pop     esi
  6770                                      ret
  6771                                  %endif
