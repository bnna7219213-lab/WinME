  8939                                      ; RVA -> file offset (pe_rva_to_fileoff takes the RVA in EAX)
  8940 00006F76 89F0                        mov     eax, esi
  8941 00006F78 E821C8FFFF                  call    pe_rva_to_fileoff
  8942 00006F7D 83F8FF                      cmp     eax, 0xFFFFFFFF
