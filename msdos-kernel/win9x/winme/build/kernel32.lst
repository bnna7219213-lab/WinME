  8945 00006F87 01C6                        add     esi, eax                ; ESI -> first IMAGE_IMPORT_DESCRIPTOR
  8946                                  
  8947                                  .rim_import_loop:
  8948 00006F89 8B1E                        mov     ebx, [esi]              ; OriginalFirstThunk RVA
  8949 00006F8B 85DB                        test    ebx, ebx
  8950 00006F8D 7462                        jz      .rim_done_ok            ; terminator
