  9478                                  ; --- VIN script ---
  9479                                  ; Packed 12-byte event: dw delay, db type, dw x, dw y, db data, db pad[4]
  9480                                  ;   (delay@0, type@2, x@3, y@5, data@7, pad@8..11) — matches VINSZ=12
  9481                                  %macro VINEV 5
  9482                                      dw      %1
  9483                                      db      %2
  9484                                      dw      %3
  9485                                      dw      %4
  9486                                      db      %5, 0, 0, 0, 0
  9487                                  %endmacro
