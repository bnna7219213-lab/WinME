  8952                                      ;                               ; by name lookup (pe_dispatch_call/cmpsb)
  8953                                      ;                               ; below, so .rim_next_import must restore it
  8954                                  
  8955                                      ; IAT in memory = pe_load_base + FirstThunk_RVA
  8956 00006F90 8B3D[C6000100]              mov     edi, [pe_load_base]
