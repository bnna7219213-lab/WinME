  8982                                      ; RVA -> IMAGE_IMPORT_BY_NAME
  8983 00006FC0 50                          push    eax
  8984 00006FC1 E8D8C7FFFF                  call    pe_rva_to_fileoff
  8985 00006FC6 59                          pop     ecx
  8986 00006FC7 83F8FF                      cmp     eax, 0xFFFFFFFF
